DB_HOST=localhost
DB_PORT=3306
DB_USER=pos_user
DB_PASSWORD=pos_password
DB_NAME=pos_coffe
PORT=4000

# Cashier auth token secret (HMAC signing) - wajib diisi secret acak yang kuat di production
CASHIER_TOKEN_SECRET=change-me-to-a-long-random-string

# Enforcement akses modul (RBAC). Default kosong/false = MODE AUDIT (pelanggaran hanya
# dicatat ke log, tidak memblokir). Set ke 'true' HANYA setelah memastikan setiap kasir
# non-admin punya akses modul yang benar (Manajemen Akses), agar tidak mengunci pengguna.
ENFORCE_MODULE_ACCESS=false

# Enforcement gating paket langganan (fitur & kuota per tier). Default kosong/false =
# MODE AUDIT (pelanggaran hanya dicatat ke log via '[PLAN AUDIT]', tidak memblokir).
# Set ke 'true' HANYA setelah data subscription_plan tenant lama sudah dimigrasi ke
# slug tier baru (rintis/toko/cabang/juragan), agar tidak mengunci pelanggan bayar.
ENFORCE_PLAN_ACCESS=false

# FTP upload (cPanel)
FTP_HOST=103.112.163.154
FTP_PORT=21
# If your user or password contains #, spaces, or special chars, wrap in quotes
FTP_USER="your_ftp_user"
FTP_PASSWORD="your_ftp_password"
# remote directory (relative to account root), e.g. public_html/uploads/pos-coffe
FTP_BASE_DIR=uploads/pos-coffe
# public URL base to access uploaded files, e.g. https://coffe.stran.my.id/uploads/pos-coffe
FTP_PUBLIC_BASE_URL=https://coffe.stran.my.id/public_html/uploads/pos-coffe

# Telegram Bot (notifikasi stok)
# Buat bot via @BotFather di Telegram untuk mendapatkan token & username
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_BOT_USERNAME=YourBotUsername
